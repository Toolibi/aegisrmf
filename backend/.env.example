# Copy to .env for local dev. In Azure these come from Key Vault references via managed identity.
AEGIS_ENV=dev
AEGIS_DATABASE_URL=postgresql+psycopg://aegis_app:CHANGE_ME@localhost:5432/aegis
AEGIS_DATA_DIR=./data
AEGIS_KEY_PEPPER=CHANGE_ME_LONG_RANDOM
AEGIS_MANIFEST_KEY=CHANGE_ME_LONG_RANDOM
AEGIS_BOOTSTRAP_TOKEN=CHANGE_ME_LONG_RANDOM
AEGIS_AI_PROVIDER=rules                      # or azure-foundry
AEGIS_AI_ENDPOINT=https://<resource>.openai.azure.com
AEGIS_AI_DEPLOYMENT=gpt-5-mini              # keyless: uses `az login` / managed identity
# Three-part CUI gate - CUI reaches the model only when ALL are true (see aegisrmf/evidence/cui_gate.py)
AEGIS_AI_MODEL=
AEGIS_AI_REGION=eastus2                      # US commercial or usgov* region
AEGIS_AI_DEPLOYMENT_TYPE=datazone_standard   # standard | provisioned | datazone_* (Global types refused)
AEGIS_AI_DATA_ZONE=us
AEGIS_AI_FEDRAMP_HIGH_CONFIRMED=false        # model is on Microsoft's FedRAMP High audit-scope list
AEGIS_AI_DFARS_CONFIRMED_BY=                 # who confirmed Microsoft's DFARS 7012 terms
AEGIS_AI_DFARS_CONFIRMED_ON=                 # ISO date
# MCP over HTTP
AEGIS_MCP_TRANSPORT=streamable-http
AEGIS_PUBLIC_URL=http://127.0.0.1:8001
AEGIS_MCP_RATE_PER_MIN=120
